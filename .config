# OpenWrt 24.10 x86_64 软路由固件配置
# 说明：这是"种子配置"，只列出需要显式设定的项。
# CI 中先重建完整包索引，再 make defconfig 展开为完整配置。
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# LuCI 与简体中文
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y

# 代理插件：仅 OpenClash（不含 Nikki / PassWall）
CONFIG_PACKAGE_luci-app-openclash=y

# DNS
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_dnsmasq-dhcpv6 is not set

# 功能插件
CONFIG_PACKAGE_frpc=y
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_netdata=y
CONFIG_PACKAGE_luci-app-netdata=y
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-timecontrol=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_openlist=y
CONFIG_PACKAGE_luci-app-openlist=y

# 关闭 Ruby YJIT（OpenClash 依赖 ruby，省资源）
# CONFIG_RUBY_ENABLE_YJIT is not set
